# POLARIS environment template.
# Copy to `.env` for local development and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production/preview/development.
# Never commit real values.

# --- Database (Supabase Postgres) -------------------------------------------
# Supavisor transaction pooler (port 6543) is recommended for serverless.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct connection (port 5432), used for migrations and drizzle-kit.
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Supabase Storage --------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only secret key; grants Storage write access. Never expose to the client.
SUPABASE_SERVICE_ROLE=
# Safe for client-side use (optional).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ASSETS_BUCKET=assets

# --- Auth --------------------------------------------------------------------
# HMAC key used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
POLARIS_SESSION_SIGNING_MATERIAL=
POLARIS_ADMIN_PASSWORD=
POLARIS_EDITOR_PASSWORD=
# Only set true for local demos that rely on the x-polaris-role header.
POLARIS_ALLOW_ROLE_HEADER=false

# --- Optional AI adapters ----------------------------------------------------
# The app defaults to a deterministic offline adapter; set these to use a live model.
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
